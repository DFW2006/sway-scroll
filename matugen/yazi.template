[manager]
cwd = { fg = "{{colors.tertiary.default.hex}}" }

hovered         = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.primary.default.hex}}" }
preview_hovered = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.on_surface.default.hex}}" }

find_keyword  = { fg = "{{colors.secondary.default.hex}}", italic = true }
find_position = { fg = "{{colors.primary.default.hex}}", bg = "reset", italic = true }

marker_copied   = { fg = "{{colors.tertiary.default.hex}}", bg = "{{colors.tertiary.default.hex}}" }
marker_cut      = { fg = "{{colors.error.default.hex}}", bg = "{{colors.error.default.hex}}" }
marker_marked   = { fg = "{{colors.secondary.default.hex}}", bg = "{{colors.secondary.default.hex}}" }
marker_selected = { fg = "{{colors.primary.default.hex}}", bg = "{{colors.primary.default.hex}}" }

tab_active   = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.on_surface.default.hex}}" }
tab_inactive = { fg = "{{colors.on_surface.default.hex}}", bg = "{{colors.surface_container_high.default.hex}}" }

count_copied   = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.tertiary.default.hex}}" }
count_cut      = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.error.default.hex}}" }
count_selected = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.primary.default.hex}}" }

border_symbol = "│"
border_style  = { fg = "{{colors.outline.default.hex}}" }

[mode]
normal_main = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.primary.default.hex}}", bold = true }
normal_alt  = { fg = "{{colors.primary.default.hex}}", bg = "{{colors.surface_container_high.default.hex}}" }

select_main = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.tertiary.default.hex}}", bold = true }
select_alt  = { fg = "{{colors.tertiary.default.hex}}", bg = "{{colors.surface_container_high.default.hex}}" }

unset_main  = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.secondary.default.hex}}", bold = true }
unset_alt   = { fg = "{{colors.secondary.default.hex}}", bg = "{{colors.surface_container_high.default.hex}}" }

[status]
separator_open  = ""
separator_close = ""

progress_label  = { fg = "#ffffff", bold = true }
progress_normal = { fg = "{{colors.primary.default.hex}}", bg = "{{colors.surface_container_high.default.hex}}" }
progress_error  = { fg = "{{colors.error.default.hex}}", bg = "{{colors.surface_container_high.default.hex}}" }

perm_type  = { fg = "{{colors.primary.default.hex}}" }
perm_read  = { fg = "{{colors.secondary.default.hex}}" }
perm_write = { fg = "{{colors.error.default.hex}}" }
perm_exec  = { fg = "{{colors.tertiary.default.hex}}" }
perm_sep   = { fg = "{{colors.outline.default.hex}}" }

[input]
border   = { fg = "{{colors.primary.default.hex}}" }
title    = {}
value    = {}
selected = { reversed = true }

[pick]
border   = { fg = "{{colors.primary.default.hex}}" }
active   = { fg = "{{colors.secondary.default.hex}}" }
inactive = {}

[confirm]
border  = { fg = "{{colors.primary.default.hex}}" }
title   = { fg = "{{colors.primary.default.hex}}" }
content = {}
list    = {}
btn_yes = { reversed = true }
btn_no  = {}

[completion]
border = { fg = "{{colors.primary.default.hex}}" }

[tasks]
border  = { fg = "{{colors.primary.default.hex}}" }
title   = {}
hovered = { underline = true }

[which]
mask            = { bg = "{{colors.surface_container_high.default.hex}}" }
cand            = { fg = "{{colors.tertiary.default.hex}}" }
rest            = { fg = "{{colors.on_surface_variant.default.hex}}" }
desc            = { fg = "{{colors.secondary.default.hex}}" }
separator       = "  "
separator_style = { fg = "{{colors.outline.default.hex}}" }

[help]
on      = { fg = "{{colors.tertiary.default.hex}}" }
run     = { fg = "{{colors.secondary.default.hex}}" }
desc    = { fg = "{{colors.on_surface_variant.default.hex}}" }
hovered = { bg = "{{colors.surface_container_high.default.hex}}", bold = true }
footer  = { fg = "{{colors.on_surface.default.hex}}", bg = "{{colors.surface_container_high.default.hex}}" }

[notify]
title_info  = { fg = "{{colors.tertiary.default.hex}}" }
title_warn  = { fg = "{{colors.secondary.default.hex}}" }
title_error = { fg = "{{colors.error.default.hex}}" }

[filetype]
rules = [
	{ mime = "image/*", fg = "{{colors.tertiary.default.hex}}" },
	{ mime = "{audio,video}/*", fg = "{{colors.secondary.default.hex}}" },
	{ mime = "application/*zip", fg = "{{colors.primary.default.hex}}" },
	{ mime = "application/x-{tar,bzip*,7z-compressed,xz,rar}", fg = "{{colors.primary.default.hex}}" },
	{ mime = "application/{pdf,doc,rtf}", fg = "{{colors.tertiary.default.hex}}" },
	{ mime = "*/*", fg = "{{colors.on_surface.default.hex}}" },
	{ mime = "inode/directory", fg = "{{colors.primary.default.hex}}" },
]
